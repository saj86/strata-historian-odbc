// Windows resources: the version (read by Test-StrataNode.ps1) and the data source settings window.
#include <windows.h>
#include "resource.h"
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION STRATA_VERSION_MAJOR, STRATA_VERSION_MINOR, STRATA_VERSION_PATCH, 0
PRODUCTVERSION STRATA_VERSION_MAJOR, STRATA_VERSION_MINOR, STRATA_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Internal"
            VALUE "FileDescription", "Strata Historian ODBC Driver"
            VALUE "FileVersion", STRATA_VERSION_TEXT
            VALUE "InternalName", "strataodbc"
            VALUE "OriginalFilename", "strataodbc.dll"
            VALUE "ProductName", "Strata Historian ODBC Driver"
            VALUE "ProductVersion", STRATA_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

IDD_DSN DIALOGEX 0, 0, 310, 278
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Strata Historian ODBC Driver: data source"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Data source name:", -1, 10, 12, 82, 10
    EDITTEXT        IDC_NAME, 95, 10, 205, 13, ES_AUTOHSCROLL
    LTEXT           "Description:", -1, 10, 30, 82, 10
    EDITTEXT        IDC_DESC, 95, 28, 205, 13, ES_AUTOHSCROLL

    GROUPBOX        "Connection", -1, 7, 47, 296, 84
    LTEXT           "Data from:", -1, 14, 61, 78, 10
    COMBOBOX        IDC_BACKEND, 95, 59, 200, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "PI Web API URL:", -1, 14, 79, 78, 10
    EDITTEXT        IDC_BASEURL, 95, 77, 200, 13, ES_AUTOHSCROLL
    LTEXT           "PI data server:", -1, 14, 97, 78, 10
    EDITTEXT        IDC_SERVER, 95, 95, 200, 13, ES_AUTOHSCROLL
    LTEXT           "Sign-in:", -1, 14, 115, 78, 10
    COMBOBOX        IDC_AUTH, 95, 113, 200, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Limits and options", -1, 7, 136, 296, 64
    LTEXT           "Longest window (days):", -1, 14, 150, 90, 10
    EDITTEXT        IDC_MAXDAYS, 105, 148, 40, 13, ES_NUMBER
    LTEXT           "Events per request:", -1, 160, 150, 80, 10
    EDITTEXT        IDC_PAGESIZE, 245, 148, 50, 13, ES_NUMBER
    AUTOCHECKBOX    "Allow a small preview in Power BI Navigator (leave off on gateways)", IDC_PREVIEW, 14, 166, 280, 10
    LTEXT           "Trace file (optional):", -1, 14, 183, 78, 10
    EDITTEXT        IDC_TRACE, 95, 181, 200, 13, ES_AUTOHSCROLL

    GROUPBOX        "Test the connection", -1, 7, 205, 296, 47
    LTEXT           "User name:", -1, 14, 219, 48, 10
    EDITTEXT        IDC_USER, 64, 217, 90, 13, ES_AUTOHSCROLL
    LTEXT           "Password:", -1, 160, 219, 38, 10
    EDITTEXT        IDC_PWD, 200, 217, 95, 13, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "Used only for this test and never saved. Leave empty for Windows sign-in.", -1, 14, 236, 225, 10
    PUSHBUTTON      "&Test", IDC_TEST, 245, 234, 50, 14

    DEFPUSHBUTTON   "OK", IDOK, 192, 258, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 253, 258, 50, 14
END
