table PressureEvents

	/// Which backend produced these rows. "fixture" means synthetic test data, never PI data.
	measure 'Data Source' = SELECTEDVALUE ( PressureEvents[SourceBackend], "mixed" )

	measure Events = COUNTROWS ( PressureEvents )
		formatString: 0

	/// Share of events, not of time. A time-based percent good needs a PI summary, which isn't implemented.
	measure 'Good Events %' = DIVIDE ( CALCULATE ( [Events], PressureEvents[IsGood] = TRUE () ), [Events] )
		formatString: 0.0%

	measure 'Bad Or System Events' = CALCULATE ( [Events], PressureEvents[IsGood] = FALSE () )
		formatString: 0

	measure 'Questionable Or Substituted' = CALCULATE ( [Events], PressureEvents[IsQuestionable] = TRUE () || PressureEvents[IsSubstituted] = TRUE () )
		formatString: 0

	measure 'Last Source Event UTC' = MAX ( PressureEvents[EventUtc] )
		formatString: yyyy-mm-dd hh:nn:ss

	measure 'Last Refresh UTC' = MAX ( RefreshStamp[RefreshedUtc] )
		formatString: yyyy-mm-dd hh:nn:ss

	/// Should be blank. A number means a capped Navigator preview got into the model.
	measure 'Preview Rows In Model' = CALCULATE ( [Events], PressureEvents[ResultScope] = "PREVIEW" )
		formatString: 0

	column PointId
		dataType: string
		summarizeBy: none
		sourceColumn: PointId

		annotation SummarizationSetBy = User

	column TagName
		dataType: string
		summarizeBy: none
		sourceColumn: TagName

		annotation SummarizationSetBy = User

	column EventUtc
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss.000
		summarizeBy: none
		sourceColumn: EventUtc

		annotation SummarizationSetBy = User

	column EventUtcRaw
		dataType: string
		summarizeBy: none
		sourceColumn: EventUtcRaw

		annotation SummarizationSetBy = User

	column EventSeq
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: EventSeq

		annotation SummarizationSetBy = User

	column ValueKind
		dataType: string
		summarizeBy: none
		sourceColumn: ValueKind

		annotation SummarizationSetBy = User

	column NumericValue
		dataType: double
		summarizeBy: none
		sourceColumn: NumericValue

		annotation SummarizationSetBy = User

	column TextValue
		dataType: string
		summarizeBy: none
		sourceColumn: TextValue

		annotation SummarizationSetBy = User

	column DigitalCode
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: DigitalCode

		annotation SummarizationSetBy = User

	column StateText
		dataType: string
		summarizeBy: none
		sourceColumn: StateText

		annotation SummarizationSetBy = User

	column EngUnits
		dataType: string
		summarizeBy: none
		sourceColumn: EngUnits

		annotation SummarizationSetBy = User

	column IsGood
		dataType: boolean
		summarizeBy: none
		sourceColumn: IsGood

		annotation SummarizationSetBy = User

	column IsQuestionable
		dataType: boolean
		summarizeBy: none
		sourceColumn: IsQuestionable

		annotation SummarizationSetBy = User

	column IsSubstituted
		dataType: boolean
		summarizeBy: none
		sourceColumn: IsSubstituted

		annotation SummarizationSetBy = User

	column IsAnnotated
		dataType: boolean
		summarizeBy: none
		sourceColumn: IsAnnotated

		annotation SummarizationSetBy = User

	column ResultScope
		dataType: string
		summarizeBy: none
		sourceColumn: ResultScope

		annotation SummarizationSetBy = User

	column SourceBackend
		dataType: string
		summarizeBy: none
		sourceColumn: SourceBackend

		annotation SummarizationSetBy = User

	partition PressureEvents = m
		mode: import
		source =
				let
				    Literal = (d as datetime) as text => DateTime.ToText(d, [Format = "yyyy-MM-dd HH:mm:ss", Culture = "en-US"]),
				    Sql =
				        "SELECT PointId, TagName, EventUtc, EventUtcRaw, EventSeq, ValueKind, NumericValue, TextValue, DigitalCode, StateText, EngUnits, IsGood, IsQuestionable, IsSubstituted, IsAnnotated, ResultScope, SourceBackend " &
				        "FROM RecordedValues WHERE PointId = '" & Text.Replace(PressurePointId, "'", "''") & "' " &
				        "AND EventUtc >= {ts '" & Literal(WindowStartUtc) & "'} AND EventUtc < {ts '" & Literal(WindowEndUtc) & "'}",
				    Source = Odbc.Query("dsn=" & Dsn, Sql)
				in
				    Source

